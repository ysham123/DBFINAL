# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cleaning_services_db

# JWT Configuration
JWT_SECRET=
JWT_EXPIRE=7d

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
CLIENT_ORIGIN=http://localhost:3000

# Administrator identity (required for setup and server startup)
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Workspace
ADMIN_LAST_NAME=Administrator
# Required by npm run setup for a new database
ADMIN_PASSWORD=
